# Static analysis, run in Docker by ~/work/rob/standards-mcp/run-phpstan.sh.
parameters:
    level: 10
    # The PHP new sites run on in production. Analyse as 8.5 even if run on an older PHP.
    phpVersion: 80500
    paths:
        - classes
        - wwwroot
        - prepend.php
        - Tests
    excludePaths:
        analyseAndScan:
            # Per-site and gitignored; ConfigSample declares the same class.
            - classes/Config/Config.php (?)
            # Codeception output, and the actor built from generated traits
            # that a fresh clone doesn't have.
            - Tests/_output/*
            - Tests/Support/*
            # WordPress, managed by WordPress and gitignored; not ours to analyse.
            - wwwroot/wp/*
    ignoreErrors:
        # Every entry script finds the project root by matching DreamHost's
        # /home/<user>/<domain> path (see CLAUDE.md), which always matches there.
        -
            message: '#^Offset 1 might not exist on array\{\}\|array\{non-falsy-string, non-falsy-string\}\.$#'
            path: wwwroot/*
    bootstrapFiles:
        - vendor/autoload.php
        - Tests/Unit/_bootstrap.php
